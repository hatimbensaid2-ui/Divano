<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_green }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}{% if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>

    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    {%- liquid
      assign font_heading = settings.font_heading
      assign font_body = settings.font_body
    -%}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <style>
      {{ font_heading | font_face: font_display: 'swap' }}
      {{ font_body | font_face: font_display: 'swap' }}
      :root {
        --color-green: {{ settings.color_green | default: '#16352B' }};
        --color-green-deep: {{ settings.color_green_deep | default: '#0F2820' }};
        --color-cream: {{ settings.color_cream | default: '#F4EFE7' }};
        --color-card: {{ settings.color_card | default: '#FBF8F3' }};
        --color-text: {{ settings.color_text | default: '#16140F' }};
        --color-muted: {{ settings.color_muted | default: '#5C5C54' }};
        --color-accent: {{ settings.color_accent | default: '#B5793A' }};
        --font-heading: {{ font_heading.family }}, {{ font_heading.fallback_families }};
        --font-body: {{ font_body.family }}, {{ font_body.fallback_families }};
        --fw-heading: {{ font_heading.weight }};
        --fw-body: {{ font_body.weight }};
        --page-width: {{ settings.page_width | default: 1320 }}px;
      }
    </style>

    <script src="{{ 'global.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="visually-hidden" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
