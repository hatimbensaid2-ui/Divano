{%- if section.settings.text != blank -%}
  <div class="announcement" style="background:{{ section.settings.bg }};color:{{ section.settings.color }};">
    <div class="page-width">
      <p class="announcement__text">{{ section.settings.text }}</p>
    </div>
  </div>
  <style>
    .announcement { font-size: .82rem; letter-spacing: .04em; }
    .announcement__text { text-align: center; padding-block: .55rem; font-weight: 500; }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Barre d'annonce",
  "settings": [
    { "type": "text", "id": "text", "label": "Texte", "default": "Livraison offerte dès 1500 MAD partout au Maroc · Paiement à la livraison" },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#0F2820" },
    { "type": "color", "id": "color", "label": "Texte", "default": "#F4EFE7" }
  ]
}
{% endschema %}
