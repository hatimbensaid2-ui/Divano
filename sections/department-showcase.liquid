{%- liquid
  assign coll = section.settings.collection
  assign has_products = false
  if coll != blank and coll.products.size > 0
    assign has_products = true
  endif
  assign cols = section.settings.products_per_row
  assign panel_link = section.settings.link | default: coll.url | default: routes.all_products_collection_url
-%}
<section class="section dept-showcase">
  <div class="page-width">
    <div class="dept-showcase__grid">

      <aside class="dept-showcase__panel" data-reveal>
        <div class="dept-showcase__panel-text">
          {%- if section.settings.eyebrow != blank -%}
            <span class="dept-showcase__eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="dept-showcase__title">{{ section.settings.title }}</h2>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <p class="dept-showcase__desc">{{ section.settings.description }}</p>
          {%- endif -%}
        </div>

        <a class="dept-showcase__media" href="{{ panel_link }}" aria-label="{{ section.settings.title | default: 'Collection' | escape }}">
          {%- if section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 800 }}"
                 srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 900 }} 900w"
                 sizes="(max-width: 900px) 90vw, 40vw"
                 alt="{{ section.settings.title | escape }}" width="800" height="700" loading="lazy">
          {%- elsif section.settings.image_fallback != blank -%}
            <img src="{{ section.settings.image_fallback | asset_url }}" alt="{{ section.settings.title | escape }}" width="800" height="700" loading="lazy">
          {%- elsif has_products and coll.featured_image -%}
            <img src="{{ coll.featured_image | image_url: width: 800 }}" alt="{{ coll.title | escape }}" width="800" height="700" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </a>

        {%- if section.settings.button_label != blank -%}
          <a href="{{ panel_link }}" class="btn btn--outline btn--small dept-showcase__cta">
            {{ section.settings.button_label }}<span class="btn__dot" style="background:var(--color-line);">{% render 'icon', icon: 'arrow-right' %}</span>
          </a>
        {%- endif -%}
      </aside>

      <div class="dept-showcase__products product-grid" style="--cols:{{ cols }};">
        {%- if has_products -%}
          {%- for product in coll.products limit: section.settings.products_to_show -%}
            {% render 'product-card', card_product: product %}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..section.settings.products_to_show) -%}
            <article class="card" data-reveal>
              <div class="card__media">
                <a class="card__media-link" href="{{ routes.all_products_collection_url }}" aria-label="Produit">
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
                </a>
              </div>
              <div class="card__body">
                <h3 class="card__title"><a href="{{ routes.all_products_collection_url }}">Produit démo</a></h3>
                <div class="card__price">0,00 dh</div>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
.dept-showcase__grid {
  display: grid;
  grid-template-columns: minmax(280px, 34%) 1fr;
  gap: clamp(20px, 3vw, 44px);
  align-items: start;
}
.dept-showcase__panel {
  position: sticky;
  top: 24px;
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
  background: var(--color-card);
  border-radius: var(--radius-l);
  padding: clamp(20px, 2.4vw, 34px);
}
.dept-showcase__eyebrow {
  display: inline-block;
  font-size: .78rem;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-bottom: .4rem;
}
.dept-showcase__title {
  font-size: clamp(1.7rem, 3vw, 2.6rem);
  line-height: 1.05;
}
.dept-showcase__desc {
  color: var(--color-muted);
  font-size: .96rem;
  line-height: 1.5;
}
.dept-showcase__media {
  display: block;
  border-radius: var(--radius-m);
  overflow: hidden;
  aspect-ratio: 4 / 5;
  background: var(--color-cream);
}
.dept-showcase__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .6s var(--ease);
}
.dept-showcase__media:hover img { transform: scale(1.04); }
.dept-showcase__cta { align-self: flex-start; }

@media (max-width: 900px) {
  .dept-showcase__grid { grid-template-columns: 1fr; }
  .dept-showcase__panel { position: static; }
  .dept-showcase__media { aspect-ratio: 16 / 10; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Rayon en vedette",
  "settings": [
    { "type": "header", "content": "Produits" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Les produits de cette collection s'affichent à droite." },
    { "type": "range", "id": "products_to_show", "label": "Produits affichés", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "range", "id": "products_per_row", "label": "Produits par ligne", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "header", "content": "Panneau (à gauche)" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Shop by department" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Lits" },
    { "type": "textarea", "id": "description", "label": "Description (optionnel)" },
    { "type": "image_picker", "id": "image", "label": "Image du rayon" },
    { "type": "text", "id": "image_fallback", "label": "Image par défaut (asset)", "info": "ex : product-sofa-boucle.png. Utilisée si aucune image n'est choisie." },
    { "type": "text", "id": "button_label", "label": "Libellé du bouton (optionnel)", "default": "Voir tout" },
    { "type": "url", "id": "link", "label": "Lien du panneau / bouton" }
  ],
  "presets": [{ "name": "Rayon en vedette" }]
}
{% endschema %}
