{%- liquid
  assign cols = section.settings.products_per_row
  assign limit = section.settings.products_to_show
-%}
<section class="section featured" id="section-{{ section.id }}">
  <div class="page-width">
    <div class="collection-head collection-head--center" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section-title">{{ section.settings.title }}</h2>
      {%- if section.settings.lead != blank -%}<p class="section-lead" style="text-align:center;">{{ section.settings.lead }}</p>{%- endif -%}

      <div class="tabs" data-tabs="{{ section.id }}" role="tablist" style="margin-top:1.4rem;">
        <button class="tab" data-tab="all" role="tab" aria-selected="true">Tout</button>
        {%- for block in section.blocks -%}
          {%- if block.settings.collection != blank -%}
            <button class="tab" data-tab="{{ block.id }}" role="tab" aria-selected="false" {{ block.shopify_attributes }}>
              {{ block.settings.label | default: block.settings.collection.title }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} Panneau « Tout » {%- endcomment -%}
    <div class="product-grid" style="--cols:{{ cols }};" data-panel="{{ section.id }}" data-key="all">
      {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
        {%- for product in section.settings.collection.products limit: limit -%}
          {% render 'product-card', card_product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..cols) -%}
          <article class="card"><a class="card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder' }}</a>
          <div class="card__body"><div><h3 class="card__title">Produit exemple</h3></div><div class="card__price">0,00 MAD</div></div></article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%} Panneaux par catégorie {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.collection != blank -%}
        <div class="product-grid" style="--cols:{{ cols }};" data-panel="{{ section.id }}" data-key="{{ block.id }}" hidden>
          {%- for product in block.settings.collection.products limit: limit -%}
            {% render 'product-card', card_product: product %}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if section.settings.button_label != blank -%}
      <div style="text-align:center;margin-top:2.6rem;" data-reveal>
        <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="btn btn--outline">
          {{ section.settings.button_label }}<span class="btn__dot" style="background:var(--color-line);">{% render 'icon', icon: 'arrow-right' %}</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection en vedette",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Notre sélection" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Produits populaires" },
    { "type": "textarea", "id": "lead", "label": "Texte", "default": "Découvrez nos pièces les plus appréciées, alliant confort, durabilité et élégance." },
    { "type": "collection", "id": "collection", "label": "Collection principale (onglet « Tout »)" },
    { "type": "range", "id": "products_to_show", "label": "Produits affichés", "min": 4, "max": 16, "step": 4, "default": 8 },
    { "type": "range", "id": "products_per_row", "label": "Produits par ligne", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Voir tout" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Onglet catégorie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Libellé de l'onglet" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Collection en vedette", "blocks": [ { "type": "tab" }, { "type": "tab" }, { "type": "tab" } ] }]
}
{% endschema %}
