<footer class="footer">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__col footer__brand">
        {%- if settings.logo_white != blank -%}
          <img src="{{ settings.logo_white | image_url: width: 280 }}" alt="{{ shop.name | escape }}" width="140" height="36">
        {%- else -%}
          <img src="{{ 'divano-logo-white.png' | asset_url }}" alt="{{ shop.name | escape }}" width="140" height="36">
        {%- endif -%}
        <p>{{ section.settings.brand_text }}</p>
        <form class="footer__form" action="/contact#newsletter" method="post" accept-charset="UTF-8">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required aria-label="{{ 'general.newsletter.label' | t }}">
          <button type="submit" class="btn btn--accent btn--small">{% render 'icon', icon: 'arrow-right' %}</button>
        </form>
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram {% render 'icon', icon: 'arrow-up-right' %}</a>{%- endif -%}
          {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook {% render 'icon', icon: 'arrow-up-right' %}</a>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok {% render 'icon', icon: 'arrow-up-right' %}</a>{%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.title }}</h4>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- elsif block.type == 'contact' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.title }}</h4>
            <ul>
              {%- if block.settings.address != blank -%}<li>{{ block.settings.address }}</li>{%- endif -%}
              {%- if block.settings.phone != blank -%}<li><a href="tel:{{ block.settings.phone | replace: ' ', '' }}">{{ block.settings.phone }}</a></li>{%- endif -%}
              {%- if block.settings.email != blank -%}<li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>{%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer__wordmark" aria-hidden="true">{{ section.settings.wordmark | default: 'DIVANO' }}</div>

    <div class="footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.rights }}</span>
      <span>{{ section.settings.payment_note }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "textarea", "id": "brand_text", "label": "Texte de marque", "default": "Du mobilier au design intemporel, pensé pour la vie moderne. Conçu pour durer, livré partout au Maroc." },
    { "type": "text", "id": "wordmark", "label": "Grand mot-symbole", "default": "DIVANO" },
    { "type": "text", "id": "rights", "label": "Mentions", "default": "Tous droits réservés." },
    { "type": "text", "id": "payment_note", "label": "Note paiement", "default": "Paiement à la livraison · Cartes bancaires" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Colonne de menu",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Boutique" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "contact",
      "name": "Coordonnées",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Contact" },
        { "type": "text", "id": "address", "label": "Adresse", "default": "Casablanca, Maroc" },
        { "type": "text", "id": "phone", "label": "Téléphone", "default": "+212 6 00 00 00 00" },
        { "type": "text", "id": "email", "label": "E-mail", "default": "contact@divano.ma" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "title": "Boutique" } },
      { "type": "menu", "settings": { "title": "Maison" } },
      { "type": "menu", "settings": { "title": "Aide" } },
      { "type": "contact", "settings": {} }
    ]
  }
}
{% endschema %}
