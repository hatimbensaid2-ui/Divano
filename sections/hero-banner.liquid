<section class="hero-banner" data-hero-slideshow>
  <div class="hero-banner__slides">
    {%- for block in section.blocks -%}
      <div class="hero-banner__slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
        <div class="hero-banner__media{% if block.settings.image == blank %} hero-banner__media--fallback{% endif %}">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 2200 }}"
                 srcset="{{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 2200 }} 2200w"
                 sizes="100vw" alt="{{ block.settings.image.alt | escape }}"
                 width="2200" height="1200" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
          {%- endif -%}
        </div>
        <div class="hero-banner__overlay"></div>
        <div class="hero-banner__content">
          <div class="page-width">
            {%- if block.settings.eyebrow != blank -%}<span class="hero-banner__eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
            {%- if block.settings.title != blank -%}<h2 class="hero-banner__title">{{ block.settings.title }}</h2>{%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <div class="hero-banner__cta">
                <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--white">{{ block.settings.button_label }}</a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="hero-banner__nav">
      <div class="page-width">
        <button class="hero-banner__arrow" type="button" data-hero-prev aria-label="Précédent">{% render 'icon', icon: 'arrow-left' %}</button>
        <button class="hero-banner__arrow" type="button" data-hero-next aria-label="Suivant">{% render 'icon', icon: 'arrow-right' %}</button>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero bannière",
  "max_blocks": 5,
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositive",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image de fond", "info": "Photo d'ambiance large (≥ 2000 px). Sans image : dégradé vert de la marque." },
        { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Mobilier d'exception · Maroc" },
        { "type": "inline_richtext", "id": "title", "label": "Titre", "default": "L'art de vivre, <em>signé Divano</em>" },
        { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir la collection" },
        { "type": "url", "id": "button_link", "label": "Lien du bouton" }
      ]
    }
  ],
  "presets": [{
    "name": "Hero bannière",
    "blocks": [
      { "type": "slide", "settings": { "eyebrow": "Mobilier d'exception · Maroc", "title": "L'art de vivre, <em>signé Divano</em>", "button_label": "Découvrir la collection" } },
      { "type": "slide", "settings": { "eyebrow": "Nouvelle collection", "title": "Sublimez chaque <em>espace de vie</em>", "button_label": "Voir les nouveautés" } }
    ]
  }]
}
{% endschema %}
