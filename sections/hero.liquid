<section class="hero">
  <div class="page-width hero__inner">
    <div class="hero__grid">
      <div class="hero__content" data-reveal>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h1 class="hero__title">{{ section.settings.title }}</h1>
        {%- if section.settings.lead != blank -%}<p class="hero__lead">{{ section.settings.lead }}</p>{%- endif -%}
        <div class="hero__cta">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--green">
              {{ section.settings.button_label }}<span class="btn__dot">{% render 'icon', icon: 'arrow-up-right' %}</span>
            </a>
          {%- endif -%}
          {%- if section.settings.link_label != blank -%}
            <a href="{{ section.settings.link_url }}" class="link-underline" style="color:#fff;">{{ section.settings.link_label }} {% render 'icon', icon: 'arrow-right' %}</a>
          {%- endif -%}
        </div>
      </div>

      <div class="hero__stage" data-reveal>
        <div class="hero__media">
          {%- if section.settings.image != blank -%}
            <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" width="900" height="675">
          {%- else -%}
            <img src="{{ 'hero-main.png' | asset_url }}" alt="{{ section.settings.title | escape }}" width="900" height="675">
          {%- endif -%}
        </div>
        {%- if section.settings.chip1_title != blank -%}
          <div class="hero__chip hero__chip--tl">
            <strong>{{ section.settings.chip1_title }}</strong>
            <span>{{ section.settings.chip1_text }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.chip2_title != blank -%}
          <div class="hero__chip hero__chip--br">
            <strong>{{ section.settings.chip2_title }}</strong>
            <span>{{ section.settings.chip2_text }}</span>
            {%- if section.settings.chip2_link != blank -%}<a class="hero__pill-link" href="{{ section.settings.chip2_link }}">Découvrir →</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Mobilier d'intérieur · Maroc" },
    { "type": "inline_richtext", "id": "title", "label": "Titre", "default": "Créer de beaux espaces pour la <em>vie moderne</em>" },
    { "type": "textarea", "id": "lead", "label": "Texte", "default": "Une collection pensée pour apporter harmonie, confort et élégance à chaque pièce de votre maison. Chaque création est conçue pour sublimer votre quotidien." },
    { "type": "image_picker", "id": "image", "label": "Image principale" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Découvrir la collection" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "text", "id": "link_label", "label": "Lien secondaire", "default": "Nos nouveautés" },
    { "type": "url", "id": "link_url", "label": "URL du lien secondaire" },
    { "type": "header", "content": "Étiquette haut-gauche" },
    { "type": "text", "id": "chip1_title", "label": "Titre", "default": "Canapé Bouclé" },
    { "type": "text", "id": "chip1_text", "label": "Texte", "default": "Le confort moelleux au design sculptural." },
    { "type": "header", "content": "Étiquette bas-droite" },
    { "type": "text", "id": "chip2_title", "label": "Titre", "default": "Fauteuil Velours" },
    { "type": "text", "id": "chip2_text", "label": "Texte", "default": "Détendez-vous dans un confort intemporel." },
    { "type": "url", "id": "chip2_link", "label": "Lien" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
