    <h1 class="section-title">Page introuvable</h1>
    <p class="section-lead" style="margin:1rem auto 2rem;">La page que vous cherchez n'existe pas ou a été déplacée.</p>
    <a href="{{ routes.root_url }}" class="btn btn--green">Retour à l'accueil<span class="btn__dot">{% render 'icon', icon: 'arrow-right' %}</span></a>
  </div>
</section>

