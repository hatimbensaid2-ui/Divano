<section class="section">
  <div class="page-width" style="max-width:820px;">
    <div class="collection-head collection-head--center" data-reveal>
      <span class="eyebrow">Divano</span>
      <h1 class="section-title">{{ page.title }}</h1>
    </div>
    <div class="rte" data-reveal style="color:var(--color-text);line-height:1.8;">
      {{ page.content }}
    </div>
  </div>
</section>

