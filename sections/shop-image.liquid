<section class="section shop-image" data-shopimage>
  <div class="page-width">
    <div class="shop-image__head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section-title">{{ section.settings.title }}</h2>
      {%- if section.settings.description != blank -%}<p class="shop-image__desc">{{ section.settings.description }}</p>{%- endif -%}
    </div>

    <div class="shop-image__viewport" data-reveal>
      {%- assign slide_total = section.blocks.size -%}
      {%- for block in section.blocks -%}
        <div class="shop-image__slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
          <div class="shop-image__grid">
            <div class="shop-image__stage{% if block.settings.image == blank %} shop-image__stage--fallback{% endif %}">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.image.alt | escape }}" width="900" height="765" loading="lazy">
              {%- endif -%}
              {%- for k in (1..4) -%}
                {%- liquid
                  assign pk = 'hp' | append: k | append: '_product'
                  assign tk = 'hp' | append: k | append: '_title'
                  assign xk = 'hp' | append: k | append: '_x'
                  assign yk = 'hp' | append: k | append: '_y'
                  assign prod = block.settings[pk]
                  assign manual_title = block.settings[tk]
                -%}
                {%- if prod != blank or manual_title != blank -%}
                  <button class="shop-image__dot" type="button" data-hotspot
                          style="left: {{ block.settings[xk] }}%; top: {{ block.settings[yk] }}%;"
                          aria-label="{% if prod != blank %}{{ prod.title | escape }}{% else %}{{ manual_title | escape }}{% endif %}"></button>
                {%- endif -%}
              {%- endfor -%}
            </div>

            <div class="shop-image__panel">
              {%- for k in (1..4) -%}
                {%- liquid
                  assign pk = 'hp' | append: k | append: '_product'
                  assign tk = 'hp' | append: k | append: '_title'
                  assign prk = 'hp' | append: k | append: '_price'
                  assign fk = 'hp' | append: k | append: '_image_fallback'
                  assign lk = 'hp' | append: k | append: '_link'
                  assign prod = block.settings[pk]
                  assign manual_title = block.settings[tk]
                  assign url = prod.url | default: block.settings[lk] | default: '#'
                -%}
                {%- if prod != blank or manual_title != blank -%}
                  <article class="shop-image__product" data-hsproduct>
                    <a class="shop-image__card" href="{{ url }}">
                      {%- if prod != blank and prod.featured_image != blank -%}
                        <img src="{{ prod.featured_image | image_url: width: 600 }}" alt="{{ prod.title | escape }}" width="360" height="360">
                      {%- elsif block.settings[fk] != blank -%}
                        <img src="{{ block.settings[fk] | asset_url }}" alt="{{ manual_title | escape }}" width="360" height="360">
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
                      {%- endif -%}
                    </a>
                    <div class="shop-image__meta">
                      <div class="shop-image__vendor">{% if prod != blank and prod.vendor != blank %}{{ prod.vendor }}{% else %}{{ section.settings.default_vendor }}{% endif %}</div>
                      <h3 class="shop-image__name"><a href="{{ url }}">{% if prod != blank %}{{ prod.title }}{% else %}{{ manual_title }}{% endif %}</a></h3>
                      <div class="shop-image__price">{% if prod != blank %}{{ prod.price | money }}{% else %}{{ block.settings[prk] }}{% endif %}</div>
                    </div>
                  </article>
                {%- endif -%}
              {%- endfor -%}

              <div class="shop-image__pager">
                {%- if slide_total > 1 -%}
                  <span class="shop-image__count">{{ forloop.index | prepend: '0' | slice: -2, 2 }} / {{ slide_total | prepend: '0' | slice: -2, 2 }}</span>
                {%- else -%}
                  <span></span>
                {%- endif -%}
                <div class="shop-image__arrows">
                  <button class="scroller__btn" type="button" {% if slide_total > 1 %}data-slide-prev{% else %}data-hs-prev{% endif %} aria-label="Précédent">{% render 'icon', icon: 'arrow-left' %}</button>
                  <button class="scroller__btn" type="button" {% if slide_total > 1 %}data-slide-next{% else %}data-hs-next{% endif %} aria-label="Suivant">{% render 'icon', icon: 'arrow-right' %}</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image shoppable",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Collection Divano" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Idéal pour les petits et grands espaces, profitez d'un confort absolu tout en ajoutant une touche d'élégance à votre intérieur grâce à la <em>collection Divano</em> modulable.</p>" },
