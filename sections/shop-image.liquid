<section class="section shop-image" data-shopimage>
  <div class="page-width">
    <div class="shop-image__head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="section-title">{{ section.settings.title }}</h2>
      {%- if section.settings.description != blank -%}<p class="shop-image__desc">{{ section.settings.description }}</p>{%- endif -%}
    </div>

    <div class="shop-image__grid">
      <div class="shop-image__stage{% if section.settings.image == blank %} shop-image__stage--fallback{% endif %}" data-reveal>
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image.alt | escape }}" width="900" height="765" loading="lazy">
        {%- endif -%}
        {%- for block in section.blocks -%}
          <button class="shop-image__dot" type="button" data-hotspot
                  style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;"
                  aria-label="{% if block.settings.product != blank %}{{ block.settings.product.title | escape }}{% else %}{{ block.settings.title | escape }}{% endif %}"
                  {{ block.shopify_attributes }}></button>
        {%- endfor -%}
      </div>

      <div class="shop-image__panel" data-reveal>
        {%- for block in section.blocks -%}
          {%- liquid
            assign p = block.settings.product
            assign url = p.url | default: block.settings.link | default: '#'
          -%}
          <article class="shop-image__product" data-hsproduct>
            <a class="shop-image__card" href="{{ url }}">
              {%- if p != blank and p.featured_image != blank -%}
                <img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.title | escape }}" width="360" height="360">
              {%- elsif block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" width="360" height="360">
              {%- elsif block.settings.image_fallback != blank -%}
                <img src="{{ block.settings.image_fallback | asset_url }}" alt="{{ block.settings.title | escape }}" width="360" height="360">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
              {%- endif -%}
            </a>
            <div class="shop-image__meta">
              <div class="shop-image__vendor">{% if p != blank and p.vendor != blank %}{{ p.vendor }}{% else %}{{ block.settings.vendor }}{% endif %}</div>
              <h3 class="shop-image__name"><a href="{{ url }}">{% if p != blank %}{{ p.title }}{% else %}{{ block.settings.title }}{% endif %}</a></h3>
              <div class="shop-image__price">{% if p != blank %}{{ p.price | money }}{% else %}{{ block.settings.price }}{% endif %}</div>
            </div>
          </article>
        {%- endfor -%}

        {%- if section.blocks.size > 1 -%}
          <div class="shop-image__arrows">
            <button class="scroller__btn" type="button" data-hs-prev aria-label="Précédent">{% render 'icon', icon: 'arrow-left' %}</button>
            <button class="scroller__btn" type="button" data-hs-next aria-label="Suivant">{% render 'icon', icon: 'arrow-right' %}</button>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image shoppable",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Collection Divano" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Idéal pour les petits et grands espaces, profitez d'un confort absolu tout en ajoutant une touche d'élégance à votre intérieur grâce à la <em>collection Divano</em> modulable.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image d'ambiance" }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Produit épinglé",
      "settings": [
        { "type": "product", "id": "product", "label": "Produit", "info": "Recommandé. Sinon, remplissez les champs manuels." },
        { "type": "range", "id": "x", "label": "Position horizontale", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y", "label": "Position verticale", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "header", "content": "Champs manuels (si pas de produit)" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_fallback", "label": "Image par défaut (asset)" },
        { "type": "text", "id": "vendor", "label": "Marque", "default": "Divano" },
        { "type": "text", "id": "title", "label": "Nom", "default": "Produit Divano" },
        { "type": "text", "id": "price", "label": "Prix", "default": "0,00 dh" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{
    "name": "Image shoppable",
    "blocks": [
      { "type": "hotspot", "settings": { "x": 40, "y": 58, "title": "Divano - Pouf", "vendor": "Divano", "price": "1 850,00 dh", "image_fallback": "product-sofa-boucle.png" } },
      { "type": "hotspot", "settings": { "x": 58, "y": 70, "title": "Fauteuil Velours", "vendor": "Divano", "price": "3 200,00 dh", "image_fallback": "product-chair-mustard.png" } },
      { "type": "hotspot", "settings": { "x": 30, "y": 45, "title": "Table d'Appoint", "vendor": "Divano", "price": "1 450,00 dh", "image_fallback": "product-side-table-gold.png" } }
    ]
  }]
}
{% endschema %}
