        { "type": "range", "id": "hp1_y", "label": "Position verticale", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 55 },
        { "type": "text", "id": "hp1_title", "label": "Nom (manuel)" },
        { "type": "text", "id": "hp1_price", "label": "Prix (manuel)" },
        { "type": "text", "id": "hp1_image_fallback", "label": "Image manuelle (asset)" },
        { "type": "url", "id": "hp1_link", "label": "Lien (manuel)" },

        { "type": "header", "content": "Produit 2 (optionnel)" },
