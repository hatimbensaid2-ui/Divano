{%- liquid
  assign target = price_target | default: product
  assign on_sale = false
  if target.compare_at_price > target.price
    assign on_sale = true
  endif
-%}
<span class="price{% if on_sale %} price--sale{% endif %}">
  {%- if on_sale -%}
    <del>{{ target.compare_at_price | money }}</del>
  {%- endif -%}
  {%- if target.price_varies and show_from -%}
    {{ 'products.product.from_price' | t: price: target.price_min | money }}
  {%- else -%}
    {{ target.price | money }}
  {%- endif -%}
</span>
