{%- liquid
  assign on_sale = false
  if card_product.compare_at_price > card_product.price
    assign on_sale = true
  endif
  assign variant = card_product.selected_or_first_available_variant
-%}
<article class="card" data-reveal>
  <div class="card__media">
    {%- if on_sale -%}
      <span class="card__badge">{{ 'products.product.on_sale' | t }}</span>
    {%- endif -%}
    <a class="card__media-link" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
      {%- if card_product.featured_media -%}
        <img
          src="{{ card_product.featured_media | image_url: width: 600 }}"
          srcset="{{ card_product.featured_media | image_url: width: 400 }} 400w, {{ card_product.featured_media | image_url: width: 700 }} 700w"
          sizes="(max-width: 720px) 50vw, 25vw"
          alt="{{ card_product.featured_media.alt | escape }}"
          loading="lazy" width="600" height="600">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </a>
    <div class="card__quick">
      {%- form 'product', card_product, class: 'card__add-form' -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" name="add" class="btn btn--green btn--small btn--block" {% unless card_product.available %}disabled{% endunless %}>
          {%- if card_product.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
        </button>
      {%- endform -%}
    </div>
  </div>
  <div class="card__body">
    <div>
      <h3 class="card__title"><a href="{{ card_product.url }}">{{ card_product.title }}</a></h3>
      {%- if card_product.vendor != blank -%}
        <p class="card__vendor">{{ card_product.vendor }}</p>
      {%- endif -%}
    </div>
    <div class="card__price">
      {%- if on_sale -%}<del>{{ card_product.compare_at_price | money }}</del>{%- endif -%}
      {{ card_product.price | money }}
    </div>
  </div>
</article>
