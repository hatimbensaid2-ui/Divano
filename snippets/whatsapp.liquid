{%- if settings.whatsapp_number != blank -%}
  {%- assign wa = settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '.', '' -%}
  <a class="whatsapp-fab{% if settings.whatsapp_label != blank %} whatsapp-fab--labeled{% endif %}"
     href="https://wa.me/{{ wa }}{% if settings.whatsapp_message != blank %}?text={{ settings.whatsapp_message | url_encode }}{% endif %}"
     target="_blank" rel="noopener" aria-label="WhatsApp">
    {% render 'icon', icon: 'whatsapp' %}
    {%- if settings.whatsapp_label != blank -%}<span class="whatsapp-fab__label">{{ settings.whatsapp_label }}</span>{%- endif -%}
  </a>
{%- endif -%}
