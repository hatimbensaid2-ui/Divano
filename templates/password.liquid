<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>
<body style="background:var(--color-green);color:#fff;min-height:100vh;display:grid;place-items:center;text-align:center;">
  <div class="page-width" style="max-width:560px;">
    <img src="{{ 'divano-logo-white.png' | asset_url }}" alt="{{ shop.name }}" style="height:42px;width:auto;margin:0 auto 2rem;">
    <h1 class="section-title">Bientôt disponible</h1>
    <p style="color:rgba(255,255,255,.78);margin:1rem 0 2rem;">Notre boutique ouvre très prochainement. Inscrivez-vous pour être informé du lancement.</p>
    {%- form 'storefront_password', class: 'newsletter__form', style: 'margin-inline:auto;' -%}
      <input class="newsletter__input" type="password" name="password" placeholder="Mot de passe" aria-label="Mot de passe">
      <button type="submit" class="btn btn--accent">Entrer</button>
    {%- endform -%}
  </div>
</body>
</html>
